{
  "name": "reqlocal",
  "version": "0.1.0",
  "description": "Request-scoped context for Node.js via AsyncLocalStorage \u2014 access typed context anywhere in the request lifecycle without parameter threading.",
  "license": "MIT",
  "author": "Abdul-Moiz31 (https://github.com/Abdul-Moiz31)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdul-Moiz31/reqlocal.git"
  },
  "keywords": [
    "async-local-storage",
    "request-context",
    "express",
    "fastify",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/logo-mark.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "fastify": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "dotenv": "^8.2.0",
    "express": "^4.19.2",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "node-fetch": "^3.3.2",
    "supertest": "^7.0.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
